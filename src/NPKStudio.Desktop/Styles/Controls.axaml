<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 20x20 线性图标（Stroke 由使用处的 Style 统一设置） -->
  <StreamGeometry x:Key="IconOpen">M3 6.5 A1.5 1.5 0 0 1 4.5 5 H7.5 L9 7 H15.5 A1.5 1.5 0 0 1 17 8.5 V15 A1.5 1.5 0 0 1 15.5 16.5 H4.5 A1.5 1.5 0 0 1 3 15 Z</StreamGeometry>
  <StreamGeometry x:Key="IconSave">M4.5 3.5 H13.5 L16.5 6.5 V16.5 H4.5 Z M7 3.5 V8 H13 V3.5 M7 11 H13 V16.5 H7 Z</StreamGeometry>
  <StreamGeometry x:Key="IconUndo">M7.5 6 L4 9.5 L7.5 13 M4 9.5 H12.5 A3.5 3.5 0 0 1 12.5 16.5 H9</StreamGeometry>
  <StreamGeometry x:Key="IconRedo">M12.5 6 L16 9.5 L12.5 13 M16 9.5 H7.5 A3.5 3.5 0 0 0 7.5 16.5 H11</StreamGeometry>
  <StreamGeometry x:Key="IconReplace">M4.5 8 A5 5 0 0 1 13.5 5.5 M13.5 5.5 V3 M13.5 5.5 H11 M15.5 12 A5 5 0 0 1 6.5 14.5 M6.5 14.5 V17 M6.5 14.5 H9</StreamGeometry>
  <StreamGeometry x:Key="IconCrop">M6 2.5 V14 H17.5 M2.5 6 H14 V17.5</StreamGeometry>
  <StreamGeometry x:Key="IconPng">M4 16.5 V3.5 H12 L16 7.5 V16.5 Z M12 3.5 V7.5 H16 M7 19 V12 M5.5 17.5 L7 19 L8.5 17.5</StreamGeometry>
  <StreamGeometry x:Key="IconGif">M4 4.5 H16 V15.5 H4 Z M4 8.5 H16 M8 8.5 V15.5 M12 8.5 V15.5</StreamGeometry>
  <StreamGeometry x:Key="IconTheme">M10 6 A4 4 0 1 0 10 14 A4 4 0 1 0 10 6 M10 1.5 V3 M10 17 V18.5 M1.5 10 H3 M17 10 H18.5 M4 4 L5 5 M15 15 L16 16 M16 4 L15 5 M5 15 L4 16</StreamGeometry>
  <StreamGeometry x:Key="IconSearch">M9 3.5 A5.5 5.5 0 1 0 9 14.5 A5.5 5.5 0 1 0 9 3.5 M13 13 L17 17</StreamGeometry>
  <StreamGeometry x:Key="IconPackage">M10 2.5 L17 6 V14 L10 17.5 L3 14 V6 Z M3 6 L10 9.5 L17 6 M10 9.5 V17.5</StreamGeometry>
  <StreamGeometry x:Key="IconManifest">M4.5 3 H13 L16 6 V17 H4.5 Z M13 3 V6 H16 M7 8.5 H13 M7 11.5 H13 M7 14.5 H10</StreamGeometry>
  <StreamGeometry x:Key="IconImage">M3.5 4.5 H16.5 V15.5 H3.5 Z M3.5 12 L7.5 8.5 L10.5 11 L13 9 L16.5 12.5 M12.5 7 A1 1 0 1 1 12.5 7.01</StreamGeometry>
  <StreamGeometry x:Key="IconChevronLeft">M12 5 L7 10 L12 15</StreamGeometry>
  <StreamGeometry x:Key="IconChevronRight">M8 5 L13 10 L8 15</StreamGeometry>
  <StreamGeometry x:Key="IconChevronDown">M5 8 L10 13 L15 8</StreamGeometry>

  <!-- 面板折叠 / 展开（« / »，双箭头 16px 使用） -->
  <StreamGeometry x:Key="IconChevronsLeft">M11.5 4.5 L6 10 L11.5 15.5 M16.5 4.5 L11 10 L16.5 15.5</StreamGeometry>
  <StreamGeometry x:Key="IconChevronsRight">M8.5 4.5 L14 10 L8.5 15.5 M3.5 4.5 L9 10 L3.5 15.5</StreamGeometry>

  <!-- 帧检查器的结构操作图标：与上面同一套 20×20 线性风格（stroke 1.5） -->
  <StreamGeometry x:Key="IconInsert">M10 4 V16 M4 10 H16</StreamGeometry>
  <StreamGeometry x:Key="IconDelete">M4.5 5.5 H15.5 M8 5.5 V3.5 H12 V5.5 M6 5.5 L7 16.5 H13 L14 5.5 M8.5 8.5 V13.5 M11.5 8.5 V13.5</StreamGeometry>
  <StreamGeometry x:Key="IconArrowUp">M10 16 V4.5 M5.5 9 L10 4.5 L14.5 9</StreamGeometry>
  <StreamGeometry x:Key="IconArrowDown">M10 4 V15.5 M5.5 11 L10 15.5 L14.5 11</StreamGeometry>

  <!-- 帧变更角标「已移动」：很小的上下双箭头（填充 / 描边由使用处给） -->
  <StreamGeometry x:Key="IconMoveVertical">M10 3.5 V16.5 M6.5 7 L10 3.5 L13.5 7 M6.5 13 L10 16.5 L13.5 13</StreamGeometry>

  <!-- 帧缩略图右上角的「已隐藏」角标：眼睛 + 一道斜杠（描边在使用处显式给，不在 Button 里） -->
  <StreamGeometry x:Key="IconEyeOff">M2.5 10 C4.6 6.2 7.1 4.6 10 4.6 C12.9 4.6 15.4 6.2 17.5 10 C15.4 13.8 12.9 15.4 10 15.4 C7.1 15.4 4.6 13.8 2.5 10 Z M10 7.6 A2.4 2.4 0 1 0 10 12.4 A2.4 2.4 0 1 0 10 7.6 M4 16.2 L16.2 3.8</StreamGeometry>

  <!-- 播放控制图标：实心形状，使用处给 Fill（不是 Stroke） -->
  <StreamGeometry x:Key="IconPlay">M6.5 4.5 L15.5 10 L6.5 15.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPause">M6 4.5 H9 V15.5 H6 Z M11 4.5 H14 V15.5 H11 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPrev">M15 4.5 L7.5 10 L15 15.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconNext">M5 4.5 L12.5 10 L5 15.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconFirst">M4.5 4.5 H6.5 V15.5 H4.5 Z M16 4.5 L7.5 10 L16 15.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconLast">M13.5 4.5 H15.5 V15.5 H13.5 Z M4 4.5 L12.5 10 L4 15.5 Z</StreamGeometry>
</ResourceDictionary>
